# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (no trailing slash). Domain not chosen yet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account (Project settings > Service accounts > Generate new private key)
# Keep the \n escapes in the private key on one line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET". Any long random string.
CRON_SECRET=
